[%General]
author=Matugen Material You
comment=Dynamic Material Design 3 theme for Kvantum
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=true
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=4
spread_progressbar=true
composite=true
menu_shadow_depth=6
tooltip_shadow_depth=4
splitter_width=4
scroll_width=10
scroll_arrows=false
scroll_min_extent=36
slider_width=6
slider_handle_width=18
slider_handle_length=18
tickless_slider_handle_size=18
center_toolbar_handle=true
check_size=16
textless_progressbar=false
progressbar_thickness=6
menubar_mouse_tracking=true
toolbutton_style=1
double_click=false
translucent_windows=false
blurring=false
popup_blurring=false
vertical_spin_indicators=false
spin_button_width=20
fill_rubberband=true
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=18
combo_as_lineedit=true
animate_states=true
button_contents_shift=false
combo_menu=true
hide_combo_checkboxes=true
tree_branch_line=true
groupbox_top_label=true
inline_spin_indicators=true
joined_inactive_tabs=false
layout_spacing=6
layout_margin=8
no_window_pattern=true
opaque=true

[Hacks]
transparent_dolphin_view=false
blur_konsole=false
transparent_ktitle_label=true
transparent_menutitle=true
respect_darkness=<* if {{ is_dark_mode }} *>true<* else *>false<* endif *>
kcapacitybar_as_progressbar=true
force_size_grip=false
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=50
lxqtmainmenu_iconsize=22
normal_default_pushbutton=true
single_top_toolbar=true
tint_on_mouseover=15
no_selection_tint=false
transparent_arrow_button=true
middle_click_scroll=false
kinetic_scrolling=true
noninteger_translucency=false
blur_only_active_window=false

[GeneralColors]
window.color={{colors.background.default.hex}}
base.color={{colors.surface.default.hex}}
alt.base.color={{colors.surface_container_low.default.hex}}
button.color={{colors.surface_container.default.hex}}
light.color={{colors.surface_container_high.default.hex}}
mid.light.color={{colors.surface_container.default.hex}}
dark.color={{colors.surface_container_lowest.default.hex}}
mid.color={{colors.outline_variant.default.hex}}
highlight.color={{colors.primary.default.hex}}
inactive.highlight.color={{colors.secondary_container.default.hex}}
text.color={{colors.on_surface.default.hex}}
window.text.color={{colors.on_background.default.hex}}
button.text.color={{colors.on_surface.default.hex}}
disabled.text.color={{colors.outline.default.hex}}
tooltip.text.color={{colors.on_surface.default.hex}}
highlight.text.color={{colors.on_primary.default.hex}}
link.color={{colors.primary.default.hex}}
link.visited.color={{colors.tertiary.default.hex}}
progress.indicator.text.color={{colors.on_primary.default.hex}}

[Window]
inherits=GeneralColors
interior.element=window
interior=true
frame=false

[Dialog]
inherits=GeneralColors
interior.element=window
interior=true
frame=false

[PanelButtonCommand]
frame.element=button
frame=true
interior=true
interior.element=button
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.normal.color={{colors.on_surface.default.hex}}
text.focus.color={{colors.on_surface.default.hex}}
text.press.color={{colors.on_primary.default.hex}}
text.toggle.color={{colors.on_primary_container.default.hex}}
text.shadow=false
text.margin=4
text.margin.top=6
text.margin.bottom=6
text.margin.left=12
text.margin.right=12

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=toolbutton
interior.element=toolbutton
text.margin.top=4
text.margin.bottom=4
text.margin.left=6
text.margin.right=6

[Toolbar]
frame.element=toolbar
interior.element=toolbar
frame=false
interior=true
text.normal.color={{colors.on_surface.default.hex}}
text.focus.color={{colors.primary.default.hex}}
text.press.color={{colors.on_primary.default.hex}}
text.toggle.color={{colors.primary.default.hex}}

[MenuBar]
frame.element=menubar
interior.element=menubar
frame=false
interior=true
text.normal.color={{colors.on_surface.default.hex}}
text.focus.color={{colors.on_surface.default.hex}}
text.press.color={{colors.primary.default.hex}}
text.toggle.color={{colors.primary.default.hex}}

[MenuBarItem]
frame.element=menuitem
interior.element=menuitem
frame=true
interior=true
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.normal.color={{colors.on_surface.default.hex}}
text.focus.color={{colors.on_primary_container.default.hex}}
text.press.color={{colors.on_primary_container.default.hex}}
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8

[Menu]
frame.element=menu
interior.element=menu
frame=true
interior=true
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.normal.color={{colors.on_surface.default.hex}}
text.shadow=false

[MenuItem]
frame.element=menuitem
interior.element=menuitem
frame=true
interior=true
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.normal.color={{colors.on_surface.default.hex}}
text.focus.color={{colors.on_primary_container.default.hex}}
text.press.color={{colors.on_primary_container.default.hex}}
text.margin.top=5
text.margin.bottom=5
text.margin.left=10
text.margin.right=10

[TitleBar]
frame.element=toolbar
interior.element=toolbar
frame=false
interior=true
text.normal.color={{colors.on_surface_variant.default.hex}}
text.focus.color={{colors.on_surface.default.hex}}

[Header]
frame.element=header
interior.element=header
frame=true
interior=true
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.normal.color={{colors.on_surface_variant.default.hex}}
text.focus.color={{colors.primary.default.hex}}
text.press.color={{colors.primary.default.hex}}
text.toggle.color={{colors.primary.default.hex}}
text.margin.top=5
text.margin.bottom=5
text.margin.left=8
text.margin.right=8

[Tab]
frame.element=tab
interior.element=tab
frame=true
interior=true
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.normal.color={{colors.on_surface_variant.default.hex}}
text.focus.color={{colors.on_surface.default.hex}}
text.press.color={{colors.primary.default.hex}}
text.toggle.color={{colors.primary.default.hex}}
text.margin.top=6
text.margin.bottom=6
text.margin.left=12
text.margin.right=12

[TabFrame]
frame.element=tabframe
interior.element=tabframe
frame=true
interior=true
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4

[LineEdit]
frame.element=lineedit
interior.element=lineedit
frame=true
interior=true
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin.top=4
text.margin.bottom=4
text.margin.left=6
text.margin.right=6

[ComboBox]
inherits=PanelButtonCommand
frame.element=combobox
interior.element=combobox
text.normal.color={{colors.on_surface.default.hex}}
text.focus.color={{colors.on_surface.default.hex}}

[SpinBox]
inherits=LineEdit

[ItemView]
frame.element=itemview
interior.element=itemview
frame=true
interior=true
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.normal.color={{colors.on_surface.default.hex}}
text.focus.color={{colors.on_surface.default.hex}}
text.press.color={{colors.on_primary_container.default.hex}}
text.toggle.color={{colors.on_primary_container.default.hex}}

[Progressbar]
frame.element=progressbar
interior.element=progressbar
frame=true
interior=true
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.normal.color={{colors.on_surface.default.hex}}
text.focus.color={{colors.on_primary.default.hex}}

[ScrollBar]
frame=false
interior=false

[Slider]
frame.element=slider
interior.element=slidercursor
frame=true
interior=true
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[Tooltip]
frame.element=tooltip
interior.element=tooltip
frame=true
interior=true
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.normal.color={{colors.on_surface.default.hex}}
text.margin=6
