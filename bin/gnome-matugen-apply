#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# gnome-matugen-apply
# Generates and applies Material You color schemes to GNOME:
# GTK 3/4, GNOME Shell, Papirus Folder Icons, and Qt5/Qt6 (qt5ct/qt6ct + Kvantum)
# ==============================================================================

SCRIPT_REAL_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
REPO_TEMPLATES_DIR="$(cd "$SCRIPT_REAL_DIR/.." 2>/dev/null && pwd)/templates"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}"
TEMPLATES_DIR="$CONFIG_DIR/gnome-matugen/templates"
THEME_DIR="$DATA_DIR/themes/Material-You/gnome-shell"

usage() {
  cat << 'EOF'
Usage:
  gnome-matugen-apply [OPTIONS]

Options:
  --image <path>       Path to wallpaper/image (Default: auto-detect from GNOME or ~/Pictures)
  --color <#hex>       Hex color value (e.g., "#3b82f6")
  --mode <dark|light>  Theme mode (Default: auto-detect from GNOME color-scheme)
  --type <type>        Scheme type (scheme-tonal-spot, scheme-expressive, scheme-fruit-salad, etc.)
  --prefer <pref>      Matugen 4+ preference (saturation, darkness, lightness, value, closest-to-fallback)
  --contrast <float>   Contrast value between -1.0 and 1.0 (Default: 0.0)
  --no-icons           Skip Papirus folder icons color synchronization
  -h, --help           Show this help message

Examples:
  gnome-matugen-apply
  gnome-matugen-apply --image ~/Pictures/wall.png --mode dark
  gnome-matugen-apply --color "#7c3aed"
EOF
}

# Sync templates from repository if running from repo checkout or if templates are missing
if [[ -d "$REPO_TEMPLATES_DIR" ]]; then
  mkdir -p "$CONFIG_DIR/gnome-matugen"
  rm -rf "$TEMPLATES_DIR"
  cp -r "$REPO_TEMPLATES_DIR" "$TEMPLATES_DIR"
fi

# Ensure Qt environment variables are properly exported in startup scripts
setup_qt_environment() {
  local env_d="$CONFIG_DIR/environment.d"
  mkdir -p "$env_d"

  # 1. environment.d for systemd user sessions
  cat > "$env_d/90-matugen-qt.conf" << 'EOF'
QT_QPA_PLATFORMTHEME=qt5ct
QT_STYLE_OVERRIDE=kvantum
EOF

  # 2. ~/.profile for login shells
  if ! grep -q 'QT_QPA_PLATFORMTHEME=qt5ct' "$HOME/.profile" 2>/dev/null; then
    cat >> "$HOME/.profile" << 'EOF'

# GNOME Matugen Qt / Kvantum integration
export QT_QPA_PLATFORMTHEME=qt5ct
export QT_STYLE_OVERRIDE=kvantum
EOF
  fi

  # 3. ~/.bashrc for interactive bash terminals
  if [[ -f "$HOME/.bashrc" ]] && ! grep -q 'QT_QPA_PLATFORMTHEME=qt5ct' "$HOME/.bashrc" 2>/dev/null; then
    cat >> "$HOME/.bashrc" << 'EOF'

# GNOME Matugen Qt / Kvantum integration
export QT_QPA_PLATFORMTHEME=qt5ct
export QT_STYLE_OVERRIDE=kvantum
EOF
  fi

  # 4. ~/.zshrc for interactive zsh terminals
  if [[ -f "$HOME/.zshrc" ]] && ! grep -q 'QT_QPA_PLATFORMTHEME=qt5ct' "$HOME/.zshrc" 2>/dev/null; then
    cat >> "$HOME/.zshrc" << 'EOF'

# GNOME Matugen Qt / Kvantum integration
export QT_QPA_PLATFORMTHEME=qt5ct
export QT_STYLE_OVERRIDE=kvantum
EOF
  fi

  # 5. Export into current shell and user systemd session
  export QT_QPA_PLATFORMTHEME="qt5ct"
  export QT_STYLE_OVERRIDE="kvantum"

  systemctl --user set-environment \
    QT_QPA_PLATFORMTHEME=qt5ct \
    QT_STYLE_OVERRIDE=kvantum 2>/dev/null || true

  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
      QT_QPA_PLATFORMTHEME=qt5ct \
      QT_STYLE_OVERRIDE=kvantum 2>/dev/null || true
  fi
}

setup_qt_environment

# Find matugen binary
find_matugen() {
  if command -v matugen >/dev/null 2>&1; then
    command -v matugen
  elif [[ -x "$HOME/.local/bin/matugen" ]]; then
    echo "$HOME/.local/bin/matugen"
  elif [[ -x "/usr/local/bin/matugen" ]]; then
    echo "/usr/local/bin/matugen"
  elif [[ -x "$HOME/.cargo/bin/matugen" ]]; then
    echo "$HOME/.cargo/bin/matugen"
  else
    echo ""
  fi
}

MATUGEN_BIN="$(find_matugen)"
if [[ -z "$MATUGEN_BIN" ]]; then
  echo "❌ Error: 'matugen' binary not found. Please install matugen or add it to PATH." >&2
  exit 1
fi

IMAGE_PATH=""
COLOR_HEX=""
MODE=""
SCHEME_TYPE="scheme-tonal-spot"
PREFER="saturation"
CONTRAST=""
SYNC_ICONS=true
EXPLICIT_MODE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --image)
      IMAGE_PATH="${2:-}"
      shift 2
      ;;
    --color)
      COLOR_HEX="${2:-}"
      shift 2
      ;;
    --mode)
      MODE="${2:-}"
      EXPLICIT_MODE=true
      shift 2
      ;;
    --type)
      SCHEME_TYPE="${2:-}"
      shift 2
      ;;
    --prefer)
      PREFER="${2:-}"
      PREFER="${PREFER//_/-}"
      shift 2
      ;;
    --contrast)
      CONTRAST="${2:-}"
      shift 2
      ;;
    --no-icons)
      SYNC_ICONS=false
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

# Detect current mode if not explicitly set via CLI
if [[ -z "$MODE" ]]; then
  CURRENT_SCHEME="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || echo "'default'")"
  CURRENT_SCHEME="${CURRENT_SCHEME//\'/}"
  if [[ "$CURRENT_SCHEME" == "prefer-light" || "$CURRENT_SCHEME" == "default" ]]; then
    MODE="light"
  else
    MODE="dark"
  fi
fi

# Detect current wallpaper dynamically (GNOME settings with robust fallback to user's Pictures/Sway)
if [[ -z "$IMAGE_PATH" && -z "$COLOR_HEX" ]]; then
  IMAGE_PATH="$(python3 - "$MODE" << 'PYEOF'
import os, sys, glob, subprocess, urllib.parse

mode = sys.argv[1]

# 1. GNOME GSettings
keys = ['picture-uri-dark', 'picture-uri'] if mode == 'dark' else ['picture-uri', 'picture-uri-dark']
for key in keys:
    try:
        uri = subprocess.check_output(
            ['gsettings', 'get', 'org.gnome.desktop.background', key],
            text=True, stderr=subprocess.DEVNULL
        ).strip().strip("'\"")
        if uri.startswith('file://'):
            p = urllib.parse.unquote(uri[7:])
            if os.path.isfile(p):
                print(p)
                sys.exit(0)
        elif os.path.isfile(uri):
            print(uri)
            sys.exit(0)
    except Exception:
        pass

# 2. Check running swaybg or sway config
try:
    out = subprocess.check_output(['pgrep', '-a', 'swaybg'], text=True, stderr=subprocess.DEVNULL)
    for part in out.split():
        if os.path.isfile(part) and any(part.lower().endswith(ext) for ext in ['.jpg', '.jpeg', '.png', '.jxl', '.webp']):
            print(part)
            sys.exit(0)
except Exception:
    pass

# 3. Common user wallpaper paths
home = os.path.expanduser('~')
candidates = [
    os.path.join(home, 'Pictures', '1.jpg'),
    os.path.join(home, 'Pictures', 'wallpaper.png'),
    os.path.join(home, 'Pictures', 'wallpaper.jpg'),
    os.path.join(home, 'Pictures', 'wall.png'),
    os.path.join(home, 'Pictures', 'wall.jpg'),
    '/usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png',
]
for c in candidates:
    if os.path.isfile(c):
        print(c)
        sys.exit(0)

# 4. Newest image in ~/Pictures (excluding screenshots)
pics = glob.glob(os.path.join(home, 'Pictures', '*.*'))
valid = [p for p in pics if any(p.lower().endswith(ext) for ext in ['.jpg', '.jpeg', '.png', '.webp', '.jxl']) and 'screenshot' not in p.lower()]
if valid:
    valid.sort(key=os.path.getmtime, reverse=True)
    print(valid[0])
    sys.exit(0)
PYEOF
  )"
fi

if [[ -z "$IMAGE_PATH" && -z "$COLOR_HEX" ]]; then
  echo "⚠️ Warning: Could not detect an image file. Using fallback accent color (#3584e4)." >&2
  COLOR_HEX="#3584e4"
fi

# Resolve XML wallpaper definitions (Debian desktop-base / GNOME timed backgrounds)
if [[ -n "$IMAGE_PATH" && -f "$IMAGE_PATH" && "${IMAGE_PATH,,}" == *.xml ]]; then
  RESOLVED_XML_IMG="$(python3 - "$IMAGE_PATH" "$MODE" << 'PYEOF'
import sys, os, re

xml_path, mode = sys.argv[1], sys.argv[2]
try:
    with open(xml_path, "r", errors="ignore") as f:
        content = f.read()
    files = [m.strip() for m in re.findall(r"<(?:file|filename|to|from)>([^<]+)</(?:file|filename|to|from)>", content)]
    valid = [p for p in files if os.path.isfile(p)]
    if valid:
        if mode == "dark":
            dark_cand = [p for p in valid if "dark" in os.path.basename(p).lower() or "-d." in os.path.basename(p).lower() or "-n." in os.path.basename(p).lower()]
            if dark_cand:
                print(dark_cand[0])
                sys.exit(0)
        print(valid[0])
except Exception:
    pass
PYEOF
  )"
  if [[ -n "$RESOLVED_XML_IMG" && -f "$RESOLVED_XML_IMG" ]]; then
    IMAGE_PATH="$RESOLVED_XML_IMG"
  fi
fi

# Handle .jxl and .svg images
TEMP_CONVERTED_IMAGE=""
cleanup_temp() {
  if [[ -n "$TEMP_CONVERTED_IMAGE" && -f "$TEMP_CONVERTED_IMAGE" ]]; then
    rm -f "$TEMP_CONVERTED_IMAGE"
  fi
  if [[ -n "${TMP_CFG:-}" && -f "$TMP_CFG" ]]; then
    rm -f "$TMP_CFG"
  fi
}
trap cleanup_temp EXIT

if [[ -n "$IMAGE_PATH" && ( "${IMAGE_PATH,,}" == *.jxl || "${IMAGE_PATH,,}" == *.svg ) ]]; then
  echo "🖼️  Converting ${IMAGE_PATH##*.} wallpaper to temporary PNG for Matugen..."
  TEMP_CONVERTED_IMAGE="$(mktemp /tmp/matugen_wall_XXXXXX.png)"

  CONVERTED=false
  if [[ "${IMAGE_PATH,,}" == *.jxl ]] && command -v djxl >/dev/null 2>&1; then
    if djxl "$IMAGE_PATH" "$TEMP_CONVERTED_IMAGE" >/dev/null 2>&1; then
      CONVERTED=true
    fi
  fi

  if [[ "$CONVERTED" != "true" && "${IMAGE_PATH,,}" == *.svg ]] && command -v rsvg-convert >/dev/null 2>&1; then
    if rsvg-convert "$IMAGE_PATH" -o "$TEMP_CONVERTED_IMAGE" >/dev/null 2>&1; then
      CONVERTED=true
    fi
  fi

  if [[ "$CONVERTED" != "true" ]] && command -v magick >/dev/null 2>&1; then
    if magick "$IMAGE_PATH" "$TEMP_CONVERTED_IMAGE" >/dev/null 2>&1; then
      CONVERTED=true
    fi
  fi

  if [[ "$CONVERTED" != "true" ]] && command -v convert >/dev/null 2>&1; then
    if convert "$IMAGE_PATH" "$TEMP_CONVERTED_IMAGE" >/dev/null 2>&1; then
      CONVERTED=true
    fi
  fi

  if [[ "$CONVERTED" != "true" ]] && command -v ffmpeg >/dev/null 2>&1; then
    if ffmpeg -y -i "$IMAGE_PATH" "$TEMP_CONVERTED_IMAGE" >/dev/null 2>&1; then
      CONVERTED=true
    fi
  fi

  if [[ "$CONVERTED" != "true" ]]; then
    if python3 -c "
import sys, gi
gi.require_version('GdkPixbuf', '2.0')
from gi.repository import GdkPixbuf
pb = GdkPixbuf.Pixbuf.new_from_file(sys.argv[1])
pb.savev(sys.argv[2], 'png', [], [])
" "$IMAGE_PATH" "$TEMP_CONVERTED_IMAGE" 2>/dev/null; then
      CONVERTED=true
    fi
  fi

  if [[ "$CONVERTED" == "true" && -s "$TEMP_CONVERTED_IMAGE" ]]; then
    IMAGE_PATH="$TEMP_CONVERTED_IMAGE"
  else
    echo "⚠️ Could not convert wallpaper image. Using fallback color (#3584e4)." >&2
    IMAGE_PATH=""
    COLOR_HEX="#3584e4"
  fi
fi

echo "🎨 Applying theme: Mode=$MODE | Scheme=$SCHEME_TYPE"
if [[ -n "$IMAGE_PATH" ]]; then
  echo "🖼️  Source Image: $IMAGE_PATH"
else
  echo "🎯 Source Color: $COLOR_HEX"
fi

# Ensure output directories exist
mkdir -p \
  "$CONFIG_DIR/gtk-3.0" \
  "$CONFIG_DIR/gtk-4.0" \
  "$CONFIG_DIR/qt5ct/colors" \
  "$CONFIG_DIR/qt6ct/colors" \
  "$CONFIG_DIR/Kvantum/MaterialYou" \
  "$CONFIG_DIR/environment.d" \
  "$THEME_DIR"

# Create a temporary config for matugen
TMP_CFG="$(mktemp --suffix=.toml)"

cat > "$TMP_CFG" << EOF
[config]

[templates.gtk3]
input_path = '$TEMPLATES_DIR/gtk.css'
output_path = '$CONFIG_DIR/gtk-3.0/gtk.css'

[templates.gtk4]
input_path = '$TEMPLATES_DIR/gtk.css'
output_path = '$CONFIG_DIR/gtk-4.0/gtk.css'

[templates.gnomeshell]
input_path = '$TEMPLATES_DIR/gnome-shell-colors.scss'
output_path = '$TEMPLATES_DIR/gnome-shell-sass/_colors.scss'

[templates.qt5]
input_path = '$TEMPLATES_DIR/qtct.conf'
output_path = '$CONFIG_DIR/qt5ct/colors/MaterialYou.conf'

[templates.qt6]
input_path = '$TEMPLATES_DIR/qtct.conf'
output_path = '$CONFIG_DIR/qt6ct/colors/MaterialYou.conf'

[templates.kdeglobals]
input_path = '$TEMPLATES_DIR/qtct.conf'
output_path = '$CONFIG_DIR/kdeglobals'

[templates.kvantum_kvconfig]
input_path = '$TEMPLATES_DIR/kvantum.kvconfig'
output_path = '$CONFIG_DIR/Kvantum/MaterialYou/MaterialYou.kvconfig'

[templates.kvantum_svg]
input_path = '$TEMPLATES_DIR/kvantum.svg'
output_path = '$CONFIG_DIR/Kvantum/MaterialYou/MaterialYou.svg'
EOF

# Build matugen command args
MATUGEN_ARGS=()
if [[ -n "$IMAGE_PATH" ]]; then
  MATUGEN_ARGS+=(image "$IMAGE_PATH" --prefer "$PREFER")
  if [[ "$PREFER" == "closest-to-fallback" ]]; then
    MATUGEN_ARGS+=(--fallback-color "#3584e4")
  fi
else
  MATUGEN_ARGS+=(color hex "$COLOR_HEX")
fi

MATUGEN_ARGS+=(-m "$MODE" -t "$SCHEME_TYPE" -c "$TMP_CFG")
if [[ -n "$CONTRAST" ]]; then
  MATUGEN_ARGS+=(--contrast "$CONTRAST")
fi

# Run Matugen with fallback protection
if ! "$MATUGEN_BIN" "${MATUGEN_ARGS[@]}" 2>/dev/null; then
  if [[ -n "$IMAGE_PATH" ]]; then
    if ! "$MATUGEN_BIN" image "$IMAGE_PATH" --source-color-index 0 -m "$MODE" -t "$SCHEME_TYPE" -c "$TMP_CFG" 2>/dev/null; then
      echo "⚠️ Matugen failed with image source. Retrying with fallback color (#3584e4)..." >&2
      "$MATUGEN_BIN" color hex "#3584e4" -m "$MODE" -t "$SCHEME_TYPE" -c "$TMP_CFG"
    fi
  else
    "$MATUGEN_BIN" color hex "#3584e4" -m "$MODE" -t "$SCHEME_TYPE" -c "$TMP_CFG"
  fi
fi

# Configure Kvantum active theme (including MaterialYouDark links for dark mode)
echo "⚙️ Configuring Kvantum & Qt5/Qt6 settings..."
cat > "$CONFIG_DIR/Kvantum/kvantum.kvconfig" << 'EOF'
[General]
theme=MaterialYou
EOF

ln -sf "MaterialYou.kvconfig" "$CONFIG_DIR/Kvantum/MaterialYou/MaterialYouDark.kvconfig" 2>/dev/null || true
ln -sf "MaterialYou.svg" "$CONFIG_DIR/Kvantum/MaterialYou/MaterialYouDark.svg" 2>/dev/null || true

if command -v kvantummanager >/dev/null 2>&1; then
  kvantummanager --set MaterialYou >/dev/null 2>&1 || true
fi

TARGET_ICON_THEME="Papirus-Dark"
if [[ "$MODE" == "light" ]]; then
  TARGET_ICON_THEME="Papirus"
fi

# Helper function to configure qt5ct.conf and qt6ct.conf
configure_qtct() {
  local qt_ver="$1"
  local cfg="$CONFIG_DIR/${qt_ver}/${qt_ver}.conf"
  local scheme_path="$CONFIG_DIR/${qt_ver}/colors/MaterialYou.conf"

  if [[ -f "$cfg" ]]; then
    python3 - "$cfg" "$scheme_path" "$TARGET_ICON_THEME" << 'PYEOF'
import sys, configparser

cfg_path, scheme_path, icon_theme = sys.argv[1], sys.argv[2], sys.argv[3]
cp = configparser.ConfigParser(interpolation=None)
cp.optionxform = str
try:
    cp.read(cfg_path)
except Exception:
    pass

if "Appearance" not in cp:
    cp["Appearance"] = {}

cp["Appearance"]["style"] = "kvantum"
cp["Appearance"]["custom_palette"] = "true"
cp["Appearance"]["color_scheme_path"] = scheme_path
cp["Appearance"]["standard_dialogs"] = "xdgdesktopportal"
cp["Appearance"]["icon_theme"] = icon_theme

with open(cfg_path, "w") as f:
    cp.write(f, space_around_delimiters=False)
PYEOF
  else
    cat > "$cfg" << EOF
[Appearance]
color_scheme_path=$scheme_path
custom_palette=true
icon_theme=$TARGET_ICON_THEME
standard_dialogs=xdgdesktopportal
style=kvantum
EOF
  fi
}

configure_qtct "qt5ct"
configure_qtct "qt6ct"

# Compile GNOME Shell CSS if sassc is available
if command -v sassc >/dev/null 2>&1; then
  echo "⚙️ Compiling GNOME Shell stylesheet..."
  sassc "$TEMPLATES_DIR/gnome-shell.scss" "$THEME_DIR/gnome-shell.css" || true

  # Reload Shell Theme via user-theme extension
  gsettings set org.gnome.shell.extensions.user-theme name '' 2>/dev/null || true
  sleep 0.1
  gsettings set org.gnome.shell.extensions.user-theme name 'Material-You' 2>/dev/null || true
else
  echo "ℹ️ Note: 'sassc' not found; skipped GNOME Shell SCSS compilation. GTK, Qt & Icons applied normally."
fi

# Apply GNOME settings
echo "✨ Updating GNOME Desktop settings..."
if [[ "$EXPLICIT_MODE" == "true" ]]; then
  if [[ "$MODE" == "dark" ]]; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || true
  else
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-light' || true
  fi
fi

# Extract generated colors from gtk.css
SOURCE_HEX="$(grep -m1 '@matugen_source_color' "$CONFIG_DIR/gtk-4.0/gtk.css" 2>/dev/null | awk '{print $3}' || true)"
ACCENT_HEX="$(grep -m1 '@define-color accent_color' "$CONFIG_DIR/gtk-4.0/gtk.css" 2>/dev/null | awk '{print $3}' | tr -d ';' || true)"
if [[ -z "$ACCENT_HEX" && -f "$CONFIG_DIR/gtk-3.0/gtk.css" ]]; then
  ACCENT_HEX="$(grep -m1 '@define-color accent_color' "$CONFIG_DIR/gtk-3.0/gtk.css" 2>/dev/null | awk '{print $3}' | tr -d ';' || true)"
fi

# Sync GNOME 47/48 native accent-color setting if supported
if [[ -n "${SOURCE_HEX:-$ACCENT_HEX}" ]]; then
  GNOME_ACCENT="$(python3 - "${SOURCE_HEX:-$ACCENT_HEX}" "$ACCENT_HEX" << 'PYEOF'
import sys, colorsys

def to_hsv(h_str):
    h_str = h_str.strip().lstrip("#")
    if len(h_str) != 6:
        return None
    r, g, b = int(h_str[0:2], 16)/255.0, int(h_str[2:4], 16)/255.0, int(h_str[4:6], 16)/255.0
    h, s, v = colorsys.rgb_to_hsv(r, g, b)
    return h * 360.0, s, v

best = None
for arg in sys.argv[1:]:
    hsv = to_hsv(arg)
    if hsv and (best is None or hsv[1] > best[1]):
        best = hsv

if not best or best[1] < 0.12:
    print("slate")
else:
    hue = best[0]
    if hue >= 345 or hue < 15:
        print("red")
    elif 15 <= hue < 42:
        print("orange")
    elif 42 <= hue < 70:
        print("yellow")
    elif 70 <= hue < 160:
        print("green")
    elif 160 <= hue < 200:
        print("teal")
    elif 200 <= hue < 255:
        print("blue")
    elif 255 <= hue < 305:
        print("purple")
    else:
        print("pink")
PYEOF
  )"
  if [[ -n "$GNOME_ACCENT" ]]; then
    gsettings set org.gnome.desktop.interface accent-color "$GNOME_ACCENT" 2>/dev/null || true
  fi
fi

# Force GTK stylesheet reload
gsettings set org.gnome.desktop.interface gtk-theme '' 2>/dev/null || true
sleep 0.1
if [[ "$MODE" == "dark" ]]; then
  gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark' 2>/dev/null || true
else
  gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3' 2>/dev/null || true
fi

# ------------------------------------------------------------------------------
# Synchronize Papirus Folder Icons
# ------------------------------------------------------------------------------
if [[ "$SYNC_ICONS" == "true" ]]; then
  SYNC_ICONS_BIN="$SCRIPT_REAL_DIR/sync-papirus-folders"
  if [[ ! -x "$SYNC_ICONS_BIN" ]]; then
    SYNC_ICONS_BIN="$HOME/.local/bin/sync-papirus-folders"
  fi

  if [[ -x "$SYNC_ICONS_BIN" ]]; then
    SYNC_ARGS=(--mode "$MODE")
    [[ -n "$COLOR_HEX" ]] && SYNC_ARGS+=(--color "$COLOR_HEX")
    [[ -n "$SOURCE_HEX" ]] && SYNC_ARGS+=(--color "$SOURCE_HEX")
    [[ -n "$ACCENT_HEX" ]] && SYNC_ARGS+=(--color "$ACCENT_HEX")
    [[ -n "$IMAGE_PATH" && -f "$IMAGE_PATH" ]] && SYNC_ARGS+=(--image "$IMAGE_PATH")

    "$SYNC_ICONS_BIN" "${SYNC_ARGS[@]}" || true
  else
    echo "⚠️ Warning: sync-papirus-folders not found at $SYNC_ICONS_BIN" >&2
  fi
fi

echo "✅ Theme applied successfully!"
