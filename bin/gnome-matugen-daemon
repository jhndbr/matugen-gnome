#!/usr/bin/env python3
import sys
import os
import time
import subprocess
import threading

# ==============================================================================
# gnome-matugen-daemon
# Native GNOME D-Bus / GSettings event listener
# Reacts immediately to wallpaper and color-scheme changes with debounce & lock
# ==============================================================================

APPLY_BIN = os.path.expanduser("~/.local/bin/gnome-matugen-apply")
if not os.path.exists(APPLY_BIN):
    APPLY_BIN = "gnome-matugen-apply"

last_trigger = 0.0
DEBOUNCE_INTERVAL = 1.0  # seconds
is_running = False
lock = threading.Lock()

def run_themer():
    global last_trigger, is_running
    with lock:
        now = time.time()
        if is_running or (now - last_trigger < DEBOUNCE_INTERVAL):
            return
        is_running = True
        last_trigger = now

    print("🔔 GNOME Settings Change detected! Re-generating theme...", flush=True)
    time.sleep(0.3)  # Allow GNOME to finish writing settings
    try:
        subprocess.run([APPLY_BIN], check=False)
    except Exception as e:
        print(f"Error executing themer: {e}", file=sys.stderr, flush=True)
    finally:
        with lock:
            is_running = False

def start_gio_listener():
    try:
        from gi.repository import Gio, GLib
    except ImportError:
        return False

    print("🚀 Starting GNOME Matugen Daemon (GIO Native Event Listener)...", flush=True)
    
    # Run once at startup
    run_themer()

    # 1. Background settings
    bg_schema = "org.gnome.desktop.background"
    source = Gio.SettingsSchemaSource.get_default()
    if source.lookup(bg_schema, True):
        bg_settings = Gio.Settings.new(bg_schema)
        bg_settings.connect("changed::picture-uri", lambda *args: run_themer())
        bg_settings.connect("changed::picture-uri-dark", lambda *args: run_themer())
    
    # 2. Interface settings (Light / Dark mode, Accent color)
    if_schema = "org.gnome.desktop.interface"
    if source.lookup(if_schema, True):
        if_settings = Gio.Settings.new(if_schema)
        if_settings.connect("changed::color-scheme", lambda *args: run_themer())
        if_settings.connect("changed::accent-color", lambda *args: run_themer())

    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    return True

def start_bash_fallback():
    print("⚠️ python-gi not found. Using unbuffered gsettings monitor fallback...", flush=True)
    run_themer()

    cmd = (
        "stdbuf -oL gsettings monitor org.gnome.desktop.background picture-uri & "
        "stdbuf -oL gsettings monitor org.gnome.desktop.background picture-uri-dark & "
        "stdbuf -oL gsettings monitor org.gnome.desktop.interface color-scheme & "
        "wait"
    )
    p = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, text=True, bufsize=1)
    for line in iter(p.stdout.readline, ""):
        if line.strip():
            run_themer()

def main():
    if not start_gio_listener():
        start_bash_fallback()

if __name__ == "__main__":
    main()
