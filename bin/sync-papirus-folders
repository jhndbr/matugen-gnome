#!/usr/bin/env python3
import os
import sys
import colorsys
import subprocess
import shutil
import time

# ==============================================================================
# sync-papirus-folders
# Dynamically adapts Papirus icon folder colors based on Material You accent color
# Operates in user space (~/.local/share/icons) without requiring sudo
# ==============================================================================

SYSTEM_ICONS_DIR = "/usr/share/icons"
USER_ICONS_DIR = os.path.expanduser("~/.local/share/icons")
THEMES = ["Papirus", "Papirus-Dark", "Papirus-Light"]

def hex_to_papirus_color(hex_str):
    hex_str = hex_str.lstrip("#")
    if len(hex_str) != 6:
        return "blue"
    r = int(hex_str[0:2], 16) / 255.0
    g = int(hex_str[2:4], 16) / 255.0
    b = int(hex_str[4:6], 16) / 255.0
    h, s, v = colorsys.rgb_to_hsv(r, g, b)
    hue_deg = h * 360.0

    if s < 0.15:
        if v < 0.25:
            return "black"
        elif v < 0.65:
            return "grey"
        else:
            return "bluegrey"

    if hue_deg < 12 or hue_deg >= 350:
        return "red"
    elif 12 <= hue_deg < 25:
        return "deeporange"
    elif 25 <= hue_deg < 42:
        return "orange"
    elif 42 <= hue_deg < 70:
        return "yellow"
    elif 70 <= hue_deg < 160:
        return "green"
    elif 160 <= hue_deg < 185:
        return "teal"
    elif 185 <= hue_deg < 205:
        return "cyan"
    elif 205 <= hue_deg < 235:
        return "blue"
    elif 235 <= hue_deg < 260:
        return "indigo"
    elif 260 <= hue_deg < 290:
        return "violet"
    elif 290 <= hue_deg < 330:
        return "magenta"
    else:
        return "pink"

def ensure_user_icons():
    os.makedirs(USER_ICONS_DIR, exist_ok=True)
    for theme in THEMES:
        user_path = os.path.join(USER_ICONS_DIR, theme)
        system_path = os.path.join(SYSTEM_ICONS_DIR, theme)
        if os.path.exists(user_path):
            continue
        if os.path.isdir(system_path):
            print(f"📦 Copying {theme} to {USER_ICONS_DIR} for user modifications...")
            try:
                subprocess.run(["cp", "-ra", system_path, user_path], check=True)
                print(f"✓ {theme} ready in {user_path}")
            except Exception as e:
                print(f"⚠️ Could not copy {theme}: {e}")

def apply_color(color_name, mode="dark"):
    papirus_bin = os.path.expanduser("~/.local/bin/papirus-folders")
    if not os.path.exists(papirus_bin):
        papirus_bin = shutil.which("papirus-folders")

    if not papirus_bin:
        print("⚠️ 'papirus-folders' script not found. Skipping folder icon color.")
        return

    print(f"📁 Changing Papirus folder color to '{color_name}'...")
    for theme in THEMES:
        user_path = os.path.join(USER_ICONS_DIR, theme)
        if os.path.exists(user_path):
            subprocess.run([papirus_bin, "-C", color_name, "-t", user_path, "-o"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            # Update GTK icon cache in user folder
            subprocess.run(["gtk-update-icon-cache", "-f", "-q", user_path],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif os.path.exists(os.path.join(SYSTEM_ICONS_DIR, theme)):
            subprocess.run([papirus_bin, "-C", color_name, "-t", theme, "-o"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # Force GNOME / Nautilus to reload icon theme
    target_icon_theme = "Papirus-Dark" if mode == "dark" else "Papirus"
    try:
        current_theme = subprocess.check_output(
            ["gsettings", "get", "org.gnome.desktop.interface", "icon-theme"],
            text=True
        ).strip().strip("'")
        
        # Toggle briefly if already set to force icon redraw
        if current_theme == target_icon_theme:
            subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", "Adwaita"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.05)
        
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", target_icon_theme],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def main():
    mode = "dark"
    hex_color = "#3584e4"

    args = sys.argv[1:]
    i = 0
    while i < len(args):
        if args[i] == "--mode" and i + 1 < len(args):
            mode = args[i + 1]
            i += 2
        elif args[i].startswith("#"):
            hex_color = args[i]
            i += 1
        else:
            i += 1

    # Read color from generated gtk css if not provided
    if hex_color == "#3584e4":
        css_path = os.path.expanduser("~/.config/gtk-4.0/gtk.css")
        if not os.path.exists(css_path):
            css_path = os.path.expanduser("~/.config/gtk-3.0/gtk.css")
        if os.path.exists(css_path):
            with open(css_path, "r") as f:
                for line in f:
                    if "@define-color accent_color" in line or "@define-color accent_bg_color" in line:
                        parts = line.strip().split()
                        if len(parts) >= 3 and parts[2].startswith("#"):
                            hex_color = parts[2].rstrip(";")
                            break

    ensure_user_icons()
    color_name = hex_to_papirus_color(hex_color)
    apply_color(color_name, mode=mode)

if __name__ == "__main__":
    main()
