#!/usr/bin/env python3
import os
import sys
import glob
import colorsys
import subprocess
import shutil
import time

# ==============================================================================
# sync-papirus-folders
# Native Material You to Papirus folder icon synchronization engine
# ==============================================================================

SYSTEM_ICONS_DIR = "/usr/share/icons"
USER_ICONS_DIR = os.path.expanduser("~/.local/share/icons")
THEMES = ["Papirus", "Papirus-Dark", "Papirus-Light"]
SIZES = ["16x16", "22x22", "24x24", "32x32", "48x48", "64x64"]

VALID_PAPIRUS_COLORS = [
    "black", "blue", "bluegrey", "breeze", "brown", "carmine", "cyan",
    "darkcyan", "deeporange", "green", "grey", "indigo", "magenta",
    "nordic", "orange", "palebrown", "paleorange", "pink", "red",
    "teal", "violet", "white", "yellow", "yaru"
]

def hex_to_papirus_color(hex_str):
    hex_str = hex_str.lstrip("#")
    if len(hex_str) != 6:
        return "blue"
    r = int(hex_str[0:2], 16) / 255.0
    g = int(hex_str[2:4], 16) / 255.0
    b = int(hex_str[4:6], 16) / 255.0
    h, s, v = colorsys.rgb_to_hsv(r, g, b)
    hue_deg = h * 360.0

    if s < 0.15:
        if v < 0.25:
            return "black"
        elif v < 0.65:
            return "grey"
        else:
            return "bluegrey"

    if hue_deg < 12 or hue_deg >= 350:
        return "red"
    elif 12 <= hue_deg < 25:
        return "deeporange"
    elif 25 <= hue_deg < 42:
        return "orange"
    elif 42 <= hue_deg < 70:
        return "yellow"
    elif 70 <= hue_deg < 160:
        return "green"
    elif 160 <= hue_deg < 185:
        return "teal"
    elif 185 <= hue_deg < 205:
        return "cyan"
    elif 205 <= hue_deg < 235:
        return "blue"
    elif 235 <= hue_deg < 260:
        return "indigo"
    elif 260 <= hue_deg < 290:
        return "violet"
    elif 290 <= hue_deg < 330:
        return "magenta"
    else:
        return "pink"

def ensure_user_icons():
    os.makedirs(USER_ICONS_DIR, exist_ok=True)
    papirus_user = os.path.join(USER_ICONS_DIR, "Papirus")
    papirus_sys = os.path.join(SYSTEM_ICONS_DIR, "Papirus")

    # Check if user Papirus exists and has places directory
    places_check = os.path.join(papirus_user, "48x48", "places")
    if not os.path.exists(places_check):
        if os.path.exists(papirus_sys):
            print(f"📦 Copying Papirus icons from {SYSTEM_ICONS_DIR} to {USER_ICONS_DIR}...", flush=True)
            for theme in THEMES:
                src = os.path.join(SYSTEM_ICONS_DIR, theme)
                dst = os.path.join(USER_ICONS_DIR, theme)
                if os.path.exists(src):
                    try:
                        shutil.copytree(src, dst, symlinks=True, dirs_exist_ok=True)
                    except Exception as e:
                        print(f"⚠️ Copy error for {theme}: {e}", flush=True)
        else:
            print("📥 Downloading official Papirus Icon Theme...", flush=True)
            cmd = f'wget -qO- https://git.io/papirus-icon-theme-install | env DESTDIR="{USER_ICONS_DIR}" sh'
            subprocess.run(cmd, shell=True)

    # Ensure all user icons are writable
    try:
        subprocess.run(["chmod", "-R", "u+w", papirus_user], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def change_folder_symlinks_direct(theme_dir, color):
    """Direct native implementation of folder color symlinks (guaranteed to work)."""
    count = 0
    for size in SIZES:
        places_dir = os.path.join(theme_dir, size, "places")
        if not os.path.isdir(places_dir):
            continue

        # Look for folder-<color>*.svg and user-<color>*.svg
        for prefix in [f"folder-{color}", f"user-{color}"]:
            pattern = os.path.join(places_dir, f"{prefix}*.svg")
            for colored_file in glob.glob(pattern):
                if os.path.islink(colored_file):
                    continue  # Only target actual SVG files, not existing symlinks

                fname = os.path.basename(colored_file)
                # Compute target symlink name by removing the color suffix
                # e.g., folder-red-documents.svg -> folder-documents.svg
                #       folder-red.svg -> folder.svg
                target_fname = fname.replace(f"-{color}", "", 1)
                symlink_path = os.path.join(places_dir, target_fname)

                try:
                    if os.path.exists(symlink_path) or os.path.islink(symlink_path):
                        os.remove(symlink_path)
                    os.symlink(fname, symlink_path)
                    count += 1
                except Exception as e:
                    pass
    return count

def apply_color(color_name, mode="dark", hex_color=""):
    if color_name not in VALID_PAPIRUS_COLORS:
        color_name = "blue"

    print(f"📁 Changing Papirus folder color to '{color_name}' (Accent: {hex_color})...", flush=True)

    ensure_user_icons()

    # 1. Native symlink updates on user themes
    papirus_user_dir = os.path.join(USER_ICONS_DIR, "Papirus")
    linked = 0
    if os.path.exists(papirus_user_dir):
        linked = change_folder_symlinks_direct(papirus_user_dir, color_name)

    # 2. Also invoke papirus-folders helper if available
    papirus_bin = os.path.expanduser("~/.local/bin/papirus-folders")
    if not os.path.exists(papirus_bin):
        papirus_bin = shutil.which("papirus-folders")

    if papirus_bin:
        subprocess.run([papirus_bin, "-C", color_name, "-t", "Papirus"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    print(f"✓ Updated {linked} Papirus folder icon definitions to '{color_name}'.", flush=True)

    # 3. Update GTK icon caches
    for theme in THEMES:
        user_path = os.path.join(USER_ICONS_DIR, theme)
        if os.path.exists(user_path):
            subprocess.run(["gtk-update-icon-cache", "-f", "-q", user_path],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 4. Force GNOME Desktop & Nautilus to reload icon theme
    target_icon_theme = "Papirus-Dark" if mode == "dark" else "Papirus"
    try:
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", "Adwaita"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(0.15)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", target_icon_theme],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        # Notify running file manager
        subprocess.run(["pkill", "-HUP", "nautilus"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["nautilus", "-q"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def main():
    mode = "dark"
    hex_color = ""

    args = sys.argv[1:]
    i = 0
    while i < len(args):
        if args[i] == "--mode" and i + 1 < len(args):
            mode = args[i + 1]
            i += 2
        elif args[i].startswith("#"):
            hex_color = args[i]
            i += 1
        else:
            i += 1

    # Read color from generated gtk css if not provided
    if not hex_color:
        css_path = os.path.expanduser("~/.config/gtk-4.0/gtk.css")
        if not os.path.exists(css_path):
            css_path = os.path.expanduser("~/.config/gtk-3.0/gtk.css")
        if os.path.exists(css_path):
            with open(css_path, "r") as f:
                for line in f:
                    if "@define-color accent_color" in line or "@define-color accent_bg_color" in line:
                        parts = line.strip().split()
                        if len(parts) >= 3 and parts[2].startswith("#"):
                            hex_color = parts[2].rstrip(";")
                            break

    if not hex_color:
        hex_color = "#3584e4"

    color_name = hex_to_papirus_color(hex_color)
    apply_color(color_name, mode=mode, hex_color=hex_color)

if __name__ == "__main__":
    main()
