#!/usr/bin/env python3
import os
import re
import sys
import glob
import math
import time
import shutil
import colorsys
import subprocess
import configparser

# ==============================================================================
# sync-papirus-folders
# Synchronizes Papirus folder icon colors with Matugen Material You palette
# Works 100% without root/sudo using ~/.local/share/icons/Papirus*
# ==============================================================================

SYSTEM_ICONS_DIR = "/usr/share/icons"
USER_ICONS_DIR = os.path.expanduser("~/.local/share/icons")
CONFIG_DIR = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))

THEMES = ["Papirus", "Papirus-Dark", "Papirus-Light"]
SIZES = ["16x16", "22x22", "24x24", "32x32", "48x48", "64x64"]

VALID_PAPIRUS_COLORS = [
    "black", "blue", "bluegrey", "breeze", "brown", "carmine", "cyan",
    "darkcyan", "deeporange", "green", "grey", "indigo", "magenta",
    "nordic", "orange", "palebrown", "paleorange", "pink", "red",
    "teal", "violet", "white", "yellow", "yaru"
]

# Standard alias symlinks inside places/ that point to base colored symlinks
STANDARD_ALIASES = {
    "inode-directory.svg": "folder.svg",
    "folder-downloads.svg": "folder-download.svg",
    "folder-desktop.svg": "user-desktop.svg",
    "desktop.svg": "user-desktop.svg",
    "folder-videos.svg": "folder-video.svg",
    "folder-public.svg": "folder-image-people.svg",
    "folder-home.svg": "user-home.svg",
    "folder_home.svg": "user-home.svg",
    "folder-images.svg": "folder-pictures.svg",
}


def classify_to_papirus(hue_deg, s, v):
    """
    Maps HSV (Hue 0-360, Saturation 0-1, Value 0-1) to the closest Papirus folder color.
    """
    if s < 0.12:
        if v < 0.22:
            return "black"
        elif v < 0.65:
            return "grey"
        else:
            return "bluegrey"

    if hue_deg >= 348 or hue_deg < 12:
        return "carmine" if v < 0.40 else "red"
    elif 12 <= hue_deg < 42:
        if s < 0.35 and v < 0.45:
            return "brown"
        elif hue_deg < 25:
            return "deeporange"
        else:
            return "orange"
    elif 42 <= hue_deg < 68:
        if s < 0.30 and v < 0.55:
            return "palebrown"
        return "yellow"
    elif 68 <= hue_deg < 155:
        return "green"
    elif 155 <= hue_deg < 185:
        return "teal"
    elif 185 <= hue_deg < 204:
        return "darkcyan" if v < 0.45 else "cyan"
    elif 204 <= hue_deg < 252:
        if s < 0.28 and v > 0.50:
            return "nordic"
        elif hue_deg >= 232:
            return "indigo"
        else:
            return "blue"
    elif 252 <= hue_deg < 290:
        return "violet"
    elif 290 <= hue_deg < 330:
        return "magenta"
    else:
        return "pink"


def hex_to_hsv(hex_str):
    hex_str = hex_str.strip().lstrip("#")
    if len(hex_str) != 6:
        return None
    try:
        r = int(hex_str[0:2], 16) / 255.0
        g = int(hex_str[2:4], 16) / 255.0
        b = int(hex_str[4:6], 16) / 255.0
        h, s, v = colorsys.rgb_to_hsv(r, g, b)
        return h * 360.0, s, v
    except ValueError:
        return None


def hex_to_papirus_color(hex_str):
    hsv = hex_to_hsv(hex_str)
    if not hsv:
        return "blue"
    return classify_to_papirus(*hsv)


def get_image_vibrant_hsv(img_path):
    """
    Extracts the dominant vibrant HSV color directly from the wallpaper image if Pillow is available.
    """
    if not img_path or not os.path.isfile(img_path):
        return None
    try:
        from PIL import Image
        import warnings
        img = Image.open(img_path).convert("RGB")
        img.thumbnail((120, 120))
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            pixels = list(img.getdata())

        candidates = []
        for r, g, b in pixels:
            h, s, v = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)
            if 0.12 < v < 0.95 and s > 0.18:
                weight = (s ** 2) * (1.0 - abs(v - 0.55) * 0.8)
                candidates.append((weight, h * 360.0, s, v))

        if candidates:
            candidates.sort(key=lambda x: x[0], reverse=True)
            top = candidates[:max(1, len(candidates) // 5)]
            sin_sum = sum(w * math.sin(math.radians(h)) for w, h, s, v in top)
            cos_sum = sum(w * math.cos(math.radians(h)) for w, h, s, v in top)
            avg_h = (math.degrees(math.atan2(sin_sum, cos_sum))) % 360.0
            total_w = sum(w for w, h, s, v in top)
            avg_s = sum(w * s for w, h, s, v in top) / total_w
            avg_v = sum(w * v for w, h, s, v in top) / total_w
            return avg_h, avg_s, avg_v
    except Exception:
        pass
    return None


def is_valid_full_papirus(theme_path):
    """
    Checks whether theme_path is a complete, non-corrupted Papirus installation
    (including 128x128 scalable places, 48x48 apps, and official index.theme).
    """
    if not os.path.isdir(theme_path):
        return False
    index_file = os.path.join(theme_path, "index.theme")
    if not os.path.isfile(index_file):
        return False
    try:
        if os.path.getsize(index_file) < 4000:
            return False
        with open(index_file, "r", errors="ignore") as f:
            head = f.read(512)
            if "Material You Dynamic Icons" in head:
                return False
    except Exception:
        return False

    required = [
        os.path.join(theme_path, "48x48", "places"),
        os.path.join(theme_path, "48x48", "apps"),
        os.path.join(theme_path, "128x128", "places"),
    ]
    for req in required:
        if not os.path.exists(req):
            return False
    return True


def ensure_user_icons():
    """
    Ensures complete copies of Papirus, Papirus-Dark, and Papirus-Light exist in
    ~/.local/share/icons/ with full directory structure, symlinks, and write permissions.
    Automatically repairs any broken/partial overlay from previous versions.
    """
    os.makedirs(USER_ICONS_DIR, exist_ok=True)

    for theme in THEMES:
        user_path = os.path.join(USER_ICONS_DIR, theme)
        sys_path = os.path.join(SYSTEM_ICONS_DIR, theme)

        if is_valid_full_papirus(user_path):
            continue

        if os.path.exists(user_path) or os.path.islink(user_path):
            print(f"🧹 Repairing incomplete icon theme at {user_path}...", flush=True)
            shutil.rmtree(user_path, ignore_errors=True)

        if os.path.isdir(sys_path):
            print(f"📦 Installing complete {theme} to {user_path}...", flush=True)
            res = subprocess.run(["cp", "-ra", sys_path, user_path], capture_output=True, text=True)
            if res.returncode == 0:
                subprocess.run(["chmod", "-R", "u+w", user_path],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                print(f"✓ {theme} ready in {user_path}", flush=True)
            else:
                print(f"⚠️ Error copying {theme}: {res.stderr.strip()}", file=sys.stderr, flush=True)


def change_folder_symlinks_direct(theme_dir, color):
    """
    Updates folder-<name>.svg and user-<name>.svg symlinks to point to the selected color.
    Strictly matches only `<prefix>.svg` and `<prefix>-*.svg` so `blue` never matches `bluegrey`.
    """
    count = 0
    for size in SIZES:
        places_dir = os.path.join(theme_dir, size, "places")
        if not os.path.isdir(places_dir):
            continue

        # If places_dir is a symlink to another theme's places_dir (e.g. Papirus-Dark -> Papirus),
        # only process real directories unless theme_dir is the base Papirus directory.
        if os.path.basename(theme_dir) != "Papirus" and os.path.islink(places_dir):
            continue

        for prefix in [f"folder-{color}", f"user-{color}"]:
            candidates = glob.glob(os.path.join(places_dir, f"{prefix}-*.svg"))
            exact = os.path.join(places_dir, f"{prefix}.svg")
            if os.path.exists(exact):
                candidates.append(exact)

            for colored_file in candidates:
                if os.path.islink(colored_file):
                    continue

                fname = os.path.basename(colored_file)
                if fname == f"{prefix}.svg":
                    target_fname = fname.replace(f"-{color}", "", 1)
                elif fname.startswith(f"{prefix}-"):
                    target_fname = fname.replace(f"-{color}-", "-", 1)
                else:
                    continue

                symlink_path = os.path.join(places_dir, target_fname)
                try:
                    if os.path.lexists(symlink_path):
                        os.remove(symlink_path)
                    os.symlink(fname, symlink_path)
                    count += 1
                except Exception:
                    pass

        # Ensure standard alias symlinks exist (inode-directory, folder-downloads, folder-desktop, etc.)
        for alias_name, target_name in STANDARD_ALIASES.items():
            alias_path = os.path.join(places_dir, alias_name)
            target_path = os.path.join(places_dir, target_name)
            if os.path.lexists(target_path) and not os.path.lexists(alias_path):
                try:
                    os.symlink(target_name, alias_path)
                except Exception:
                    pass

    return count


def update_gtk_qt_icon_configs(target_icon_theme):
    """
    Synchronizes icon_theme in GTK3/GTK4 settings.ini and qt5ct/qt6ct configuration files.
    """
    for gtk_dir in ["gtk-3.0", "gtk-4.0"]:
        ini_path = os.path.join(CONFIG_DIR, gtk_dir, "settings.ini")
        if os.path.isfile(ini_path):
            cp = configparser.ConfigParser(interpolation=None)
            cp.optionxform = str
            try:
                cp.read(ini_path)
                if "Settings" not in cp:
                    cp["Settings"] = {}
                cp["Settings"]["gtk-icon-theme-name"] = target_icon_theme
                with open(ini_path, "w") as f:
                    cp.write(f, space_around_delimiters=False)
            except Exception:
                pass

    for qt_ver in ["qt5ct", "qt6ct"]:
        cfg_path = os.path.join(CONFIG_DIR, qt_ver, f"{qt_ver}.conf")
        if os.path.isfile(cfg_path):
            cp = configparser.ConfigParser(interpolation=None)
            cp.optionxform = str
            try:
                cp.read(cfg_path)
                if "Appearance" not in cp:
                    cp["Appearance"] = {}
                cp["Appearance"]["icon_theme"] = target_icon_theme
                with open(cfg_path, "w") as f:
                    cp.write(f, space_around_delimiters=False)
            except Exception:
                pass


def apply_color(color_name, mode="dark", hex_color=""):
    if color_name not in VALID_PAPIRUS_COLORS:
        color_name = "blue"

    print(f"📁 Changing Papirus folder color to '{color_name}' (Matugen color: {hex_color})...", flush=True)

    ensure_user_icons()

    papirus_user_dir = os.path.join(USER_ICONS_DIR, "Papirus")
    if not os.path.isdir(papirus_user_dir):
        print("⚠️ Papirus directory not found in ~/.local/share/icons/Papirus", file=sys.stderr, flush=True)
        return

    # 1. Update symlinks via fast native Python engine across all installed user Papirus variants
    total_linked = 0
    for theme_name in THEMES:
        t_dir = os.path.join(USER_ICONS_DIR, theme_name)
        if os.path.isdir(t_dir):
            total_linked += change_folder_symlinks_direct(t_dir, color_name)

    # 2. Also run papirus-folders CLI if available to keep config/state in sync
    papirus_bin = os.path.expanduser("~/.local/bin/papirus-folders")
    if not os.path.isfile(papirus_bin) or not os.access(papirus_bin, os.X_OK):
        papirus_bin = shutil.which("papirus-folders") or ""

    if papirus_bin and total_linked == 0:
        subprocess.run([papirus_bin, "-C", color_name, "-t", papirus_user_dir, "-o"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    print(f"✓ Updated Papirus folder icons to '{color_name}' ({total_linked} symlinks).", flush=True)

    # 3. Update directory timestamps & GTK icon caches (prioritizing active theme first)
    target_icon_theme = "Papirus-Dark" if mode == "dark" else "Papirus"
    ordered_themes = [target_icon_theme] + [t for t in THEMES if t != target_icon_theme]

    for idx, theme_name in enumerate(ordered_themes):
        user_path = os.path.join(USER_ICONS_DIR, theme_name)
        if os.path.isdir(user_path):
            try:
                os.utime(user_path, None)
            except Exception:
                pass
            subprocess.run(["gtk-update-icon-cache", "-f", "-t", "-q", user_path],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            # Immediately after updating the active theme's cache, trigger GNOME/GTK reload
            if idx == 0:
                update_gtk_qt_icon_configs(target_icon_theme)
                try:
                    subprocess.run(
                        ["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", "Adwaita"],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                    )
                    time.sleep(0.15)
                    subprocess.run(
                        ["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", target_icon_theme],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                    )
                except Exception:
                    pass


def extract_colors_from_gtk_css():
    """
    Reads @matugen_source_color and @define-color accent_color from generated gtk.css.
    """
    source_hex = ""
    accent_hex = ""
    for gtk_ver in ["gtk-4.0", "gtk-3.0"]:
        css_path = os.path.join(CONFIG_DIR, gtk_ver, "gtk.css")
        if os.path.isfile(css_path):
            try:
                with open(css_path, "r") as f:
                    content = f.read()
                m_src = re.search(r"@matugen_source_color\s+(#[0-9a-fA-F]{6})", content)
                if m_src and not source_hex:
                    source_hex = m_src.group(1)
                m_acc = re.search(r"@define-color\s+accent_(?:bg_)?color\s+(#[0-9a-fA-F]{6})", content)
                if m_acc and not accent_hex:
                    accent_hex = m_acc.group(1)
                if source_hex and accent_hex:
                    break
            except Exception:
                pass
    return source_hex, accent_hex


def main():
    mode = "dark"
    cli_colors = []
    image_path = ""

    args = sys.argv[1:]
    i = 0
    while i < len(args):
        if args[i] == "--mode" and i + 1 < len(args):
            mode = args[i + 1]
            i += 2
        elif args[i] == "--color" and i + 1 < len(args):
            cli_colors.append(args[i + 1])
            i += 2
        elif args[i] == "--image" and i + 1 < len(args):
            image_path = args[i + 1]
            i += 2
        elif args[i].startswith("#"):
            cli_colors.append(args[i])
            i += 1
        else:
            i += 1

    css_source_hex, css_accent_hex = extract_colors_from_gtk_css()
    candidates_hex = [c for c in (cli_colors + [css_source_hex, css_accent_hex]) if c]

    # Pick the candidate color with the strongest chromatic saturation so dark-mode
    # pastel tints never wash out the true Matugen seed hue
    best_hex = ""
    best_hsv = None
    for c in candidates_hex:
        hsv = hex_to_hsv(c)
        if not hsv:
            continue
        if best_hsv is None or hsv[1] > best_hsv[1]:
            best_hsv = hsv
            best_hex = c

    # If the color is nearly neutral/grey and we have a wallpaper image, check image vibrant HSV
    if image_path and (best_hsv is None or best_hsv[1] < 0.18):
        img_hsv = get_image_vibrant_hsv(image_path)
        if img_hsv and (best_hsv is None or img_hsv[1] > best_hsv[1]):
            best_hsv = img_hsv
            r, g, b = colorsys.hsv_to_rgb(img_hsv[0] / 360.0, img_hsv[1], img_hsv[2])
            best_hex = f"#{int(r * 255):02x}{int(g * 255):02x}{int(b * 255):02x}"

    if not best_hex:
        best_hex = "#3584e4"
        best_hsv = hex_to_hsv(best_hex)

    color_name = classify_to_papirus(*best_hsv) if best_hsv else hex_to_papirus_color(best_hex)
    apply_color(color_name, mode=mode, hex_color=best_hex)


if __name__ == "__main__":
    main()
